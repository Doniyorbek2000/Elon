{
  "name": "bozor-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Bozor.uz API: marketplace, jobs, services, chat",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "dev": "tsc -p tsconfig.build.json && node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/prisma/seed.js",
    "test": "jest --config jest.unit.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.6",
    "@prisma/client": "6.19.3",
    "@sentry/node": "^11.1.0",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "google-auth-library": "10.9.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "multer": "2.4.0",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "socket.io": "4.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.4",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "uuid": "^14.0.0",
    "socket.io": "$socket.io"
  }
}
