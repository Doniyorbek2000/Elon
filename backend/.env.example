# ─────────────────────────────────────────────────────────────────────────────
# Bozor.uz API configuration. Copy to `.env` for local development.
# Every variable is validated at startup (src/config/env.ts); the process
# refuses to boot on missing/unsafe values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
PORT=3000
# used to build media URLs
PUBLIC_API_URL=http://localhost:3000
# comma-separated; REQUIRED in production
CORS_ORIGINS=
LOG_LEVEL=info
# /api/v1/docs (never served in production)
SWAGGER_ENABLED=true
# share links: {WEB_BASE_URL}/listing/{id}
WEB_BASE_URL=https://bozor.uz

# Data stores
DATABASE_URL=postgresql://bozor:bozor_dev_password@localhost:5432/bozor?schema=public
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# OTP
#   dev   → code stored in memory/logged only in development (forbidden in production)
#   eskiz → Eskiz.uz SMS gateway (needs ESKIZ_EMAIL / ESKIZ_PASSWORD)
#   none  → OTP disabled (requests fail with 503)
OTP_PROVIDER=dev
# true: return code in API response (dev emulators only)
OTP_DEV_ECHO=false
# openssl rand -hex 32
OTP_HASH_SECRET=
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546

# Object storage (any S3-compatible: SeaweedFS/MinIO locally, AWS S3, Cloudflare R2)
# empty for AWS S3
S3_ENDPOINT=http://localhost:8333
# "auto" for Cloudflare R2
S3_REGION=us-east-1
S3_BUCKET=bozor-media
# local SeaweedFS identity (docker/seaweedfs-s3.json)
S3_ACCESS_KEY_ID=bozor_dev_access
S3_SECRET_ACCESS_KEY=bozor_dev_secret_key
S3_FORCE_PATH_STYLE=true
# optional CDN in front of the bucket (public renditions)
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_UPLOAD_BYTES=15728640

# Push notifications
#   fcm  → Firebase Cloud Messaging HTTP v1 (Android + iOS via APNs)
#   log  → records pushes in-process (development/tests)
#   none → disabled
PUSH_PROVIDER=log
FCM_PROJECT_ID=
# service-account JSON (raw or base64)
FCM_SERVICE_ACCOUNT=

# Business rules
USD_TO_UZS_RATE=12600
LISTING_TTL_DAYS=30
JOB_TTL_DAYS=30

# Monetization is prepared but inactive until these are enabled.
FEATURE_MONETIZATION=false
FEATURE_PAID_PROMOTIONS=false
FEATURE_BUSINESS_ACCOUNTS=false
